# ============================================
# Microservices Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- JWT ---
JWT_SECRET=your-jwt-secret-change-in-production

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USERS_DB_NAME=users_db
NOTIFICATIONS_DB_NAME=notifications_db

# --- NATS ---
NATS_URL=nats://nats:4222
NATS_USER=nats_user
NATS_PASSWORD=nats_password_change_me

# --- API Gateway ---
API_GATEWAY_PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- User Service ---
USER_SERVICE_PORT=3001
USER_SERVICE_URL=http://user-service:3001

# --- Notification Service ---
NOTIFICATION_SERVICE_PORT=3002
NOTIFICATION_SERVICE_URL=http://notification-service:3002

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development
